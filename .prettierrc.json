{
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "none",
  "overrides": [
    {
      "files": "public/**/*.mjs",
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    },
    {
      "files": "*.md",
      "options": {
        "printWidth": 120,
        "proseWrap": "always"
      }
    }
  ]
}
